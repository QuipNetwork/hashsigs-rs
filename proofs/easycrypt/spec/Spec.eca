op TAG_UXMSS_WOTS_CHAIN_SECRET : bytes = [117; 120; 109; 115; 115; 45; 119; 111; 116; 115; 45; 99; 104; 97; 105; 110; 45; 115; 101; 99; 114; 101; 116].

